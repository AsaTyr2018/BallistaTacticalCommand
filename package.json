{
  "name": "ballista-tactical-command",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "music:manifest": "node scripts/generate-music-manifest.cjs",
    "dev": "npm run music:manifest && vite --host 127.0.0.1",
    "start": "npm run music:manifest && vite --host 127.0.0.1 --port 5173",
    "build": "npm run music:manifest && vite build",
    "screenshots": "node scripts/capture-screenshots.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
